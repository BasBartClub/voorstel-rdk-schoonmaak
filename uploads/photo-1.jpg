;flex-direction:column}.mono-video-wrapper{aspect-ratio:16/9}.cookieconsent-optin-marketing.mono-video-wrapper{display:block !important}.cookieconsent-optin-marketing.mono-video-wrapper[data-cybot-cookiebot-blocked="true"]{display:none !important}.cookie-placeholder-text{font-size:16px;line-height:20px;word-break:break-word;hyphens:auto}.cookie-placeholder-icon{font-size:60px !important;margin-bottom:10px;margin-top:-7px;color:#262628}.cookie-placeholder-button{font-size:16px;color:#FFFFFF;cursor:pointer;background-color:#262628;display:block;text-align:center;padding:5px;margin-top:10px;width:100%;word-break:break-word}.cookie-fit-content{height:100%;min-height:140px}.cookie-facebook-page{width:340px;min-width:180px}.cookie-facebook-post{width:350px;min-width:350px}.cookie-facebook-video{width:220px;min-width:220px}.cookie-facebook-comment{width:220px;min-width:220px}.cookie-facebook-small{width:min-content;min-width:450px;height:min-content}.cookie-facebook-small .cookiebot-placeholder{aspect-ratio:unset} </style><!--[if IE 8]><link rel="stylesheet" href="https://site-assets.cdnmns.com/4461fb153de0bd0ff5b12a5c05bd5a61/css/cookiebotVideoPlaceholder.css?1794394802543"><![endif]--><style>#CookiebotWidget{display:none !important} </style><!--[if IE 8]><link rel="stylesheet" href="https://site-assets.cdnmns.com/4461fb153de0bd0ff5b12a5c05bd5a61/css/cookiebotOverrideWidgetHide.css?1794394802543"><![endif]--><script async> let retries = 0; const checkWidgetExists = setInterval(() => { retries++; if( document.getElementById('CookiebotWidget')){ document.getElementById('CookiebotWidget').remove(); } if(retries>= 50){ clearInterval(checkWidgetExists); } }, 100); </script><!--[if lt IE 9]><script src="https://site-assets.cdnmns.com/4461fb153de0bd0ff5b12a5c05bd5a61/js/html5shiv.js"></script><script src="https://site-assets.cdnmns.com/4461fb153de0bd0ff5b12a5c05bd5a61/js/respond.js"></script><![endif]--><script>if ('serviceWorker' in navigator){ navigator.serviceWorker.getRegistrations().then(function(registrations){ for(var i=0;i<registrations.length;i++){ registrations[i].unregister(); } }); if(window.caches){ caches.keys().then(function(names){ for(var i=0;i<names.length;i++){ caches.delete(names[i]); } }); } }</script><link rel="preconnect" href="https://site-assets.cdnmns.com/" crossorigin><link rel="preconnect" href="https://fonts.prod.extra-cdn.com" crossorigin><style id='globalCSS'>/*global data phone number doesn't fall in two lines on small screens*/ span[data-mono-global="phone"] { white-space: nowrap;} </style><meta name="format-detection" content="telephone=no"> <script>window.ASSETSURL='https://site-assets.cdnmns.com/4461fb153de0bd0ff5b12a5c05bd5a61';</script></head> <body id="p9533" data-dateformat='d/m/Y' data-req="quicklink"> <noscript><iframe data-cookieconsent="statistics" data-cookieblock-src="https://www.googletagmanager.com/ns.html?id=GTM-false" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript> <div id="r5001" class="row designRow"> <div class="container container-fluid"><div class="col col-sm-12"> <header data-req="headerfixed" data-settings="headerfixed-lg,headerfixed-md,headerfixed-sm"><div id="r3894" class="row "> <div class="container container-fixed "><div id="c1599" class="col col col-sm-7 hidden-sm col-lg-12 col-md-12"><div id="m1603" class="module text hidden-sm"><p class="custom1" style="text-align: right;">Afspraak of offerte? Bel&nbsp;<span data-global="phone"  style="font-weight: bold;">0314-36 51 35</span><br></p></div> </div> </div> </div> <div id="r5000" class="row "> <div class="container container-fixed"><div id="c5000" class="col col-sm-8 col-md-5 col-lg-12 flexCol"><div id="m3175" class="module autospacer"></div> <div class="flexWrap"> <a href="/"  title="" aria-label="" class="imageModuleWrap" id="w_m4090" data-track-event="click" data-track-action="internal_link_clicked"> <img id="m4090" class="module image" src="/uploads/2w1Kh0R1/401x0_1140x0/1809450_logo.png" alt="RDK" data-author="" width="324" height="100" data-req="" data-settings="enablehover=false,showelement=none,hovertransition=slowFadeIn"/> </a> </div> <div id="m4279" class="module autospacer"></div> </div> <div id="c4354" class="col col-sm-4 col-md-7 col-lg-12 flexCol"><div id="m4218" class="module autospacer"></div> <div class="flexWrap"> <div id="m1087" class="module divider hidden-md hidden-sm"></div> <nav id="m5000" class="module nav" data-settings="vertical=false,direction=right,push=true,activeParent=false,verticalNav-md=true" tabindex="-1"> <ul class="navContainer"><li class=" active"> <a href="/" data-track-event="click" data-track-action="internal_link_clicked">Home</a> </li><li class=""> <a href="/glasbewassing" data-track-event="click" data-track-action="internal_link_clicked">Glasbewassing</a> </li><li class=""> <a href="/interieurverzorging" data-track-event="click" data-track-action="internal_link_clicked">Interieurverzorging</a> </li><li class=""> <a href="/gevelreiniging" data-track-event="click" data-track-action="internal_link_clicked">Gevelreiniging</a> </li><li class=""> <a href="/zakelijke-markt" data-track-event="click" data-track-action="internal_link_clicked">Zakelijke markt</a> </li><li class=""> <a href="/contact" data-track-event="click" data-track-action="internal_link_clicked">Contact</a> </li></ul> </nav></div> <div id="m4149" class="module autospacer"></div> </div> </div> </div> </header><div id="r5002" role="main" class="row designRow"> <div class="container container-fluid"><div class="col col-sm-12"><div id="r4509" class="row row hidden-md hidden-lg"> <div class="container container-fixed"><div id="c2965" class="col col-sm-12"><a id="m4817" class="module button" href="tel:+31314365135"  title="" role="button" data-track-event="click" data-track-action="phone_link"> <i class="buttonIcon fa fa-phone "></i> <span class="buttonLabel labelRight">Bel nu</span> </a></div> </div> </div> <div id="r3260" class="row "> <div class="container container-fixed"><div class="col hidden-md hidden-sm col-sm-1"></div> <div class="col col-lg-10 col-sm-12"><div id="m1449" class="module text"><h1 style="text-align: center;" class="headline">Schoonmaakbedrijf RDK&nbsp;verzorgt&nbsp;uw glasbewassing, interieurverzorging en gevelreiniging</h1></div> <a id="m2669" class="module button2" href="/contact"  title="" role="button" data-track-event="click" data-track-action="internal_link_clicked"> <span class="buttonLabel labelRight">Neem contact op</span> </a> </div> <div class="col hidden-md hidden-sm col-sm-1"></div> </div> </div> <div id="r1071" class="row "> <div class="container container-fixed"><div id="c4055" class="col col-sm-12 col-lg-3 col-md-6 flexCol"><div class="flexWrap"> <div class="imageModuleWrap" id="w_m4493"> <img id="m4493" class="module image" src="/uploads/g0WjHRyS/465x0_345x0/1809450_010.jpg" alt="" data-author="" width="235" height="313" data-req="" data-settings="enablehover=false,showelement=none,hovertransition=slowFadeIn"/> </div><div id="m4283" class="module text"><h2 class="spottext" style="color: rgb(51, 51, 51); text-align: left;">Glasbewassing</h2><p class="bodytext">Wilt u schone en streeploze ramen? Of heeft u een raam waar u niet goed bij komt? RDK&nbsp;is uw glazenwasser voor elk raam. Vraag naar de mogelijkheden.&nbsp;<a href="/contact" data-track-event="click" data-track-action="internal_link_clicked">Neem contact op</a>.</p></div> </div> <div id="m4954" class="module autospacer"></div> <div class="flexWrap"> <a id="m2125" class="module button" href="/glasbewassing"  title="" role="button" data-track-event="click" data-track-action="internal_link_clicked"> <span class="buttonLabel labelRight">Lees verder</span> </a></div> </div> <div id="c4698" class="col col-sm-12 col-lg-3 col-md-6 flexCol"><div class="flexWrap"> <div class="imageModuleWrap" id="w_m4739"> <img id="m4739" class="module image" src="/uploads/Kkwp1mk3/727x0_540x0/1809450_054.jpg" alt="interieurverzorging" data-author="" width="417" height="310" data-req="" data-settings="enablehover=false,showelement=none,hovertransition=slowFadeIn"/> </div><div id="m1649" class="module text"><h2 class="spottext" style="text-align: left;">Interieurverzorging</h2><p class="bodytext" style="text-align: left;">U wilt toch ook een schone en hygiënische werkplek? RDK&nbsp;doet uw totale interieur-verzorging, van vloeronderhoud tot reinigen van sanitair. Wilt u weten wat RDK&nbsp;voor u kan doen? <a href="/contact" data-track-event="click" data-track-action="internal_link_clicked">Neem contact op</a>.<br></p></div> </div> <div id="m2541" class="module autospacer"></div> <div class="flexWrap"> <a id="m4051" class="module button" href="/interieurverzorging"  title="" role="button" data-track-event="click" data-track-action="internal_link_clicked"> <span class="buttonLabel labelRight">Lees verder</span> </a></div> </div> <div id="c4956" class="col col-sm-12 col-lg-3 col-md-6 flexCol"><div class="flexWrap"> <div class="imageModuleWrap" id="w_m2705"> <img id="m2705" class="module image" src="/uploads/T4iyo5By/727x0_540x0/1809450_055.jpg" alt="gevelreiniging" data-author="" width="438" height="324" data-req="" data-settings="enablehover=false,showelement=none,hovertransition=slowFadeIn"/> </div><div id="m4634" class="module text"><h2 class="spottext" style="text-align: left;">Gevelreiniging</h2><p style="text-align: left;" class="bodytext">Mos of aanslag op uw gevel of straatwerk? RDK verwijdert het vuil van uw gevel, zodat de gevel er weer strak bij staat. Vraag naar de reinigingsmogelijkheden voor verschillende materialen.&nbsp;<a href="/contact" data-track-event="click" data-track-action="internal_link_clicked">Neem contact op</a>.</p></div> </div> <div id="m3844" class="module autospacer"></div> <div class="flexWrap"> <a id="m1519" class="module button" href="/gevelreiniging"  title="" role="button" data-track-event="click" data-track-action="internal_link_clicked"> <span class="buttonLabel labelRight">Lees verder</span> </a></div> </div> <div id="c4611" class="col col-sm-12 col-lg-3 col-md-6"> <div class="imageModuleWrap" id="w_m4136"> <img id="m4136" class="module image" src="/uploads/F2Dn66on/669x0_496x0/schoonmaak.PNG" alt="" data-author="" width="584" height="466" data-req="" data-settings="enablehover=false,showelement=none,hovertransition=slowFadeIn"/> </div><div id="m4189" class="module text"><h2 class="spottext" style="text-align: left;">Zakelijke markt</h2><p class="bodytext" style="text-align: left;">U kunt RDK&nbsp;ook inschakelen voor de incidentele of periodieke schoonmaak van uw bedrijfspand. Zo nemen wij graag het schoonmaakonderhoud of de glasbewassing van uw kantoor of winkel voor onze rekening. Wilt u weten wat RDK&nbsp;voor de zakelijke markt kan betekenen? <a href="/contact" data-track-event="click" data-track-action="internal_link_clicked">Neem contact op</a>.<br></p></div> <a id="m2110" class="module button" href="/zakelijke-markt"  title="" role="button" data-track-event="click" data-track-action="internal_link_clicked"> <span class="buttonLabel labelRight">Lees verder</span> </a></div> </div> </div> <div id="r2827" class="row "> <div class="container container-fixed "><div id="c1440" class="col col-sm-12"><div id="m2912" class="module divider"></div> </div> </div> </div> <div id="r2299" class="row "> <div class="container container-fixed"><div class="col col-md-6 col-lg-6 col-sm-12"><div id="m3841" class="module text"><h2 style="text-align: left;" class="subtitle">Uw schoonmaakbedrijf met ervaring voor geheel Oost-Nederland&nbsp;</h2>Sinds 1995 doet glazenwassers- en schoonmaakbedrijf RDK&nbsp;allerlei soorten reinigingswerkzaamheden. U kunt hierbij denken aan interieurverzorging, glasbewassing, gevelreiniging, hogedrukreiniging, reiniging van houtwerk en vloeronderhoud. Door jarenlange ervaring, bijscholing en het gebruik van moderne technieken heeft RDK&nbsp;inmiddels vele vaste klanten. Benieuwd of&nbsp;RDK&nbsp;ook u aan een schoon pand kan helpen? Wij reinigen voor:<br><ul><li class="bodytext">Bedrijven</li><li class="bodytext">VvE's</li><li class="bodytext">Woningbouwstichtingen</li><li class="bodytext">Appartementencomplexen</li><li class="bodytext">Artsenpraktijken</li><li class="bodytext">Winkels</li></ul></div> <div id="m1287" class="module gallery" data-req="gallery,lightbox" data-settings="arrows=true,margin=2,margin-md=2,margin-sm=6,imagenr=1,gallerycaptioninpopup=true,imagenr-md=1,imagenr-sm=1" data-before-text="Voor" data-after-text="Na" role="region"> <div class="slides"> <div class="slide"> <ul class="pics clear"> <li> <a href="/uploads/xB9KBoWA/767x0_2560x0/1809450_005.JPG" title="" data-track-event="click" data-track-action="internal_link_clicked"> <span class="thumb"> <span class="thumbInner"> <img src="/uploads/xB9KBoWA/726x0_555x0/1809450_005.JPG" alt="schoonmaakbedrijf doetinchem" width="1024" height="768" data-author="" data-ai=""/> </span> </span> <span class="bodytext caption"></span> </a> </li> <li> <a href="/uploads/fEFTfUSv/767x0_2560x0/1809450_006.JPG" title="" data-track-event="click" data-track-action="internal_link_clicked"> <span class="thumb"> <span class="thumbInner"> <img src="/uploads/fEFTfUSv/726x0_555x0/1809450_006.JPG" alt="glazenwassers rdk" width="1024" height="768" data-author="" data-ai=""/> </span> </span> <span class="bodytext caption"></span> </a> </li> <li> <a href="/uploads/J1rdFRN9/767x0_2560x0/1809450_007.JPG" title="" data-track-event="click" data-track-action="internal_link_clicked"> <span class="thumb"> <span class="thumbInner"> <img src="/uploads/J1rdFRN9/726x0_555x0/1809450_007.JPG" alt="glasbewassing op locatie" width="1024" height="768" data-author="" data-ai=""/> </span> </span> <span class="bodytext caption"></span> </a> </li> <li> <a href="/uploads/Vq3wWlOu/767x0_2560x0/1809450_008.JPG" title="" data-track-event="click" data-track-action="internal_link_clicked"> <span class="thumb"> <span class="thumbInner"> <img src="/uploads/Vq3wWlOu/726x0_555x0/1809450_008.JPG" alt="auto's schoonmaakbedrijf oost-nederland" width="1024" height="768" data-author="" data-ai=""/> </span> </span> <span class="bodytext caption"></span> </a> </li> </ul> </div> </div> </div></div> <div id="c4059" class="col col-md-6 col-lg-6 col-sm-12 flexCol"><div class="flexWrap"> <div id="m4803" class="module text"><h2 class="subtitle" style="color: rgb(0, 64, 255);">RDK is werkzaam in geheel Oost-Nederland, waaronder:</h2><ul style="color: rgb(102, 102, 102); font-size: 18px;"><li class="bodytext">Winterswijk</li><li class="bodytext">Aalten</li><li class="bodytext">Doetinchem</li><li class="bodytext">Ulft</li><li class="bodytext">Zevenaar</li><li class="bodytext">Dieren</li><li class="bodytext">Arnhem</li></ul><p class="bodytext"><span></span></p><p class="bodytext"><span></span></p><p class="bodytext"><span></span></p><p class="bodytext"><span></span></p></div> </div> <div id="m3323" class="module autospacer"></div> <div class="flexWrap"> <div id="m3593" class="module text"><h2 style="text-align: left;" class="subtitle">Sponsor van Elver&nbsp;Zorg</h2><p>Glazenwassers- en schoonmaakbedrijf RDK&nbsp;is met trots PRO partner van Elver&nbsp;Zorg. Dit is een organisatie die hoogwaardige en innovatieve zorg biedt aan mensen met een matige tot zeer ernstige verstandelijke beperking.</p></div> <a href="https://www.vriendenvanelver.nl/" target="_blank" rel="noopener" title="" aria-label="" class="imageModuleWrap" id="w_m3416" data-track-event="click" data-track-action="link_clicked"> <img id="m3416" class="module image" src="/uploads/3qsc48aK/727x0_555x0/logo-elver.png" alt="logo elver" data-author="" width="204" height="63" data-req="" data-settings="enablehover=false,showelement=none,hovertransition=slowFadeIn"/> </a> </div> </div> </div> </div> <div id="r1260" class="row "> <div class="container container-fixed "><div id="c2300" class="col col-sm-12"><div id="m1851" class="module divider"></div> </div> </div> </div> <div id="r3769" class="row "> <div class="container container-fixed"><div class="col col-sm-12"><a id="m1327" class="module button button3" href="/contact"  title="" role="button" data-track-event="click" data-track-action="internal_link_clicked"> <span class="buttonLabel labelRight">Vraag een offerte aan</span> </a> </div> </div> </div> <div id="r1647" class="row row hidden-sm"> <div class="container container-fixed"><div id="c2092" class="col col col-sm-1 hidden-md hidden-sm flexCol"><div id="m1036" class="module autospacer"></div> </div> <div id="c1192" class="col col-lg-10 col-sm-12"><ul id="m1799" class="module iconlist"> <li class=" "> <a href="/contact" data-track-event="click" data-track-action="internal_link_clicked"> <i class="iconItem fa fa-phone-square "></i> </a> </li> </ul><div id="m2193" class="module text"><h3 style="text-align: center;" class="smallsubtitle">Wilt u een offerte? Neem vrijblijvend contact op via&nbsp;<span data-global="phone">0314-36 51 35</span>&nbsp;<br></h3></div> <a id="m2740" class="module button" href="/contact"  title="" role="button" data-track-event="click" data-track-action="internal_link_clicked"> <span class="buttonLabel labelRight">Neem contact met ons op</span> </a></div> <div id="c1134" class="col col col-sm-1 hidden-md hidden-sm flexCol"><div id="m3372" class="module autospacer"></div> </div> </div> </div> <div id="r4040" class="row "> <div class="container container-fixed"><div class="col hidden-md hidden-sm col-sm-1"></div> <div class="col col-lg-10 col-sm-12"><div id="m4281" class="module text"><p class="subtitle">Contactformulier</p></div> <form method="post" id="m2463" class="module form" data-url="?m=m2463" data-req="form,ext-https://js.hcaptcha.com/1/api.js?onload=formsInitHcaptcha&render=explicit" data-settings="margin=3" data-track-action="custom_form" onsubmit="return _monoForm.submitForm(this);"> <div class="fields clear"> <div class="field w100 "> <label for="m2463_field_0">Naam*</label> <input type="text" name="field_0" autocomplete="on" id="m2463_field_0" placeholder="" data-required="true" aria-required="true"/> </div> <div class="field w50 "> <label for="m2463_field_1">E-mail *</label> <input type="text" data-type="email" name="field_1" autocomplete="email" id="m2463_field_1" placeholder="" data-required="true" aria-required="true"/> </div> <div class="field w50 "> <label for="m2463_field_2">Telefoonnummer</label> <input type="text" data-type="phone" name="field_2" autocomplete="tel" id="m2463_field_2" placeholder=""/> </div> <div class="field w100 "> <label for="m2463_field_3">Bericht*</label> <textarea name="field_3" id="m2463_field_3" data-required="true" aria-required="true" placeholder=""></textarea> </div> <div class="field w100 "> <p class="subtitle">*Verplicht</p> <p class="fieldDescription"></p> </div> <input type="hidden" name="__requestToken" value="c881cecef38bef38571a83692b1b1d3dc20189b9f449dfd1f5cd49b1d06f9279"/> <div class="field veiled" style="display:none;height:0px" tabindex="-1"> <label for="103c25d1" style="display: none;">Spam protection</label> <textarea id="103c25d1" name="103c25d1" placeholder="Lorem ipsum"></textarea> </div> <input type="hidden" name="_ha_seed" value="103c25d1"/> </div> <div class="optins clear"> <div class="field w100 optin"> <div class="form_option"><input type="checkbox" name="optin_field_0" id="m2463_optin_field_0" value="1"/><label class="label_optin_field_0" for="m2463_optin_field_0"><a class="optinLink" rel="nofollow noopener" target="_blank" href="/uploads/Privacyverklaringcompleet" data-track-event="click" data-track-action="file_download">We gebruiken de informatie in dit formulier om contact met u op te nemen over uw vraag. Door dit formulier te verzenden, gaat u ermee akkoord dat wij uw gegevens kunnen verzamelen en gebruiken voor de redenen die hierboven genoemd staan. Klik hier voor meer informatie.</a></label> </div> </div> </div> <div class="h-captcha" data-sitekey="76e5ed29-5d40-4f15-b471-4c89196dac3b" data-callback="onHcaptchaSuccess"></div> <div id="errors_m2463"> </div> <input type="hidden" name="form_m2463" value="1"> <input type="submit" class="button " value="Verzenden"> </form> </div> <div class="col hidden-md hidden-sm col-sm-1"></div> </div> </div> </div> </div> </div> <footer><div id="r1074" class="row "> <div class="container container-fixed"><div class="col col-sm-12 col-md-6"><a id="m2400" class="module button hidden-md hidden-lg" href="tel:+31314365135"  title="" role="button" data-track-event="click" data-track-action="phone_link"> <i class="buttonIcon fa fa-phone "></i> <span class="buttonLabel labelRight">Bel nu</span> </a><div id="m1028" class="module text"><p class="footertext"><span style="font-weight: bold;">RDK</span><br>Haareweg 72&nbsp;<br>7009 EE Doetinchem</p></div> </div> <div id="c3299" class="col col-sm-12 col-md-6"><div id="m2647" class="module text"><p data-global="phone"  class="footertext">0314-36 51 35<a href="tel:0314-36 51 35" data-track-event="click" data-track-action="phone_link"></a><span style="font-weight: bold;"></span></p><p class="footertext"><a href="mailto:info@rdkschoonmaak.nl" data-track-event="click" data-track-action="email_link">info@rdkschoonmaak.nl</a><br></p><p class="footertext"><span style="font-weight: bold;">KvK</span>: 09087201</p><p class="footertext"><a href="/uploads/Privacyverklaringcompleet" target="_blank" rel="noopener" download="" data-track-event="click" data-track-action="file_download">Privacyverklaring</a></p></div> </div> </div> </div> </footer> <div class="row brandfooter"> <div class="container container-fixed"> <div class="col col-md-8 col-lg-8 col-sm-6"> </div> <div class="col col-md-4 col-lg-4 col-sm-6 brandLogoContainer"> <span class="brandfooter">Powered by</span> <a href="https://www.youvia.nl" target="_blank" rel="noopener" data-track-event="click" data-track-action="link_clicked"> <img class="footerlogo" src="https://site-assets.cdnmns.com/4461fb153de0bd0ff5b12a5c05bd5a61/css/img/dtg/logo_dark_en_2.png" alt="Youvia | Online marketing bureau | Jouw Partner in online success"> </a> </div> </div> </div></div> </div> </div> <script async data-cookieconsent="ignore" nomodule src="https://site-assets.cdnmns.com/4461fb153de0bd0ff5b12a5c05bd5a61/js/loader-polyfills.js?1794394802543"></script><script async data-cookieconsent="ignore" src="https://site-assets.cdnmns.com/4461fb153de0bd0ff5b12a5c05bd5a61/js/loader.js?1794394802543"></script><script type='application/ld+json'>{"@context":"http://schema.org","@type":"LocalBusiness","@id":"https://www.rdkschoonmaak.nl/#global_business","name":"RDK","address":{"@type":"PostalAddress","streetAddress":"Haareweg 72","addressLocality":"Doetinchem","addressRegion":"","postalCode":"7009 EE","addressCountry":"Netherlands"},"email":"info@rdkschoonmaak.nl","telephone":"0314-36 51 35","url":"https://www.rdkschoonmaak.nl","logo":"https://www.rdkschoonmaak.nl/uploads/2w1Kh0R1/1809450_logo.png"}</script><!-- Cookiebot: Google consent mode v2 defaults --> <script type='text/javascript' data-cookieconsent='ignore'> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('consent', 'default', { 'ad_storage': 'denied', 'analytics_storage': 'denied', 'ad_user_data': 'denied', 'ad_personalization': 'denied', 'functionality_storage': 'denied', 'personalization_storage': 'denied', 'security_storage': 'granted', 'wait_for_update': 500, }); gtag("set", "ads_data_redaction", true); gtag("set", "url_passthrough", false); </script><!-- Mono global site tag (gtag.js) - Google Analytics --> <script async type='text/plain' data-cookieconsent='statistics' src='https://www.googletagmanager.com/gtag/js?id=G-V9W617TV0J'></script> <script type='text/plain' data-cookieconsent='statistics'> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-V9W617TV0J', { 'anonymize_ip': true, 'send_page_view': false, 'custom_map': {'dimension1': 'monoSiteId', 'dimension2': 'mon